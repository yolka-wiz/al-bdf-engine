#!/usr/bin/env bash
# albdf pre-commit hook
#
# 1. Regenerates REPO_MAP.md (deterministic orientation index) and stages it,
#    so the committed map always reflects the committed tree.
# 2. Runs the markdown structure gate on STAGED .md files (except README.md
#    and vendored skills/), enforcing the "structured, not minimal" doc rule.
# 3. Scans staged files for high-signal secret patterns (API keys, tokens,
#    private keys). Fails the commit if found.
# 4. Runs the anti-slop gate (scripts/check-slop.sh --staged) on staged source
#    files: frozen-file growth, unowned TODO/FIXME/HACK/XXX, missing SPDX on
#    new files, assert-as-validation in src/PdfTool/**. Fatal — the same check
#    is CI stage 5, so bypassing it only defers the failure.
#
# Install:  scripts/install-hooks.sh   (sets core.hooksPath to .githooks)
# Skip:     git commit --no-verify      (or SKIP=1 git commit ...)
#
# Fail-fast, deterministic, no network. Exits 1 on gate failure (aborts commit).

set -u

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ---- 1. Regenerate REPO_MAP.md ---------------------------------------------
if python3 "$REPO_DIR/scripts/gen-repo-map.py" >/dev/null 2>&1; then
    # Stage the regenerated map so it rides along with the commit.
    git -C "$REPO_DIR" add REPO_MAP.md 2>/dev/null || true
else
    echo "pre-commit: WARNING: REPO_MAP.md regeneration failed — skipping (not blocking)."
fi

# ---- 2. Markdown structure gate on staged .md files ------------------------
STAGED_MD="$(git -C "$REPO_DIR" diff --cached --name-only --diff-filter=ACM -- '*.md' 2>/dev/null || true)"

if [ -n "$STAGED_MD" ]; then
    # shellcheck disable=SC2086
    if ! python3 "$REPO_DIR/scripts/check-markdown-structure.py" $STAGED_MD; then
        echo
        echo "pre-commit: markdown structure gate FAILED (staged .md files above)."
        echo "Fix the doc (add an H1 title + sections) or stage only intended files."
        echo "To bypass: git commit --no-verify"
        exit 1
    fi
fi

# ---- 3. Secret scan on staged files ----------------------------------------
# High-signal patterns only: private key blocks and common long-lived token
# formats. Low-signal words (password=, token=) are NOT scanned to avoid
# false positives on PDF4QT's encryption code and docs.
STAGED="$(git -C "$REPO_DIR" diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)"
if [ -n "$STAGED" ]; then
    LEAKED="$(grep -rInE \
        --exclude-dir=.git --exclude-dir=build --exclude-dir=build-asan \
        --exclude='*.ttf' --exclude='*.png' --exclude='*.pdf' --exclude='*.bin' \
        -e '-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----' \
        -e 'ghp_[A-Za-z0-9]{36}' \
        -e 'gho_[A-Za-z0-9]{36}' \
        -e 'github_pat_[A-Za-z0-9_]{22,}' \
        -e 'AKIA[0-9A-Z]{16}' \
        -e 'sk-[A-Za-z0-9]{20,}' \
        -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
        $STAGED 2>/dev/null || true)"
    if [ -n "$LEAKED" ]; then
        echo
        echo "pre-commit: SECRET SCAN FAILED — possible credential in staged files:"
        echo "$LEAKED"
        echo "Remove the secret (or rotate it if it was ever pushed) and re-commit."
        echo "To bypass (NOT recommended): git commit --no-verify"
        exit 1
    fi
fi

# ---- 4. Anti-slop gate on staged source files ------------------------------
# Fatal on a real violation (exit 1). Any other non-zero (should be impossible
# for --staged) warns instead of blocking, so a broken gate cannot wedge commits.
if [ -x "$REPO_DIR/scripts/check-slop.sh" ]; then
    bash "$REPO_DIR/scripts/check-slop.sh" --staged
    SLOP_RC=$?
    if [ "$SLOP_RC" -eq 1 ]; then
        echo
        echo "pre-commit: anti-slop gate FAILED (staged source files above)."
        echo "Own markers (TODO(#123)), add the SPDX header, or shrink the frozen file."
        echo "To bypass: git commit --no-verify"
        exit 1
    elif [ "$SLOP_RC" -ne 0 ]; then
        echo "pre-commit: anti-slop gate could not run (rc=$SLOP_RC) — skipping (not blocking)."
    fi
fi

exit 0
